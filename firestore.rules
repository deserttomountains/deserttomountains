rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - preserve existing functionality with email/phone protection
    match /users/{userId} {
      // Users can read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admins can read all user data (CRITICAL - was missing!)
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Allow list for duplicate checking (crucial for the duplicate detection)
      allow list: if request.auth != null;
      
      // Additional protection: Prevent direct client updates to email/phone fields
      // This rule will be evaluated AFTER the general write rule above
      allow update: if request.auth != null && 
                   request.auth.uid == userId &&
                   // Prevent client-side updates to email and phone during profile updates
                   // But allow them during initial creation (signup process)
                   (
                     // If email field is being updated, it must remain the same
                     (!('email' in request.resource.data) || 
                      request.resource.data.email == resource.data.email) &&
                     // If phone field is being updated, it must remain the same  
                     (!('phone' in request.resource.data) || 
                      request.resource.data.phone == resource.data.phone)
                   );
    }
    
    // Leads collection - admin only
    match /leads/{leadId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Orders collection - exactly like your original rules
    match /orders/{orderId} {
      // Admins can do everything
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // CRITICAL: Allow customers to create their own orders (was missing!)
      allow create: if request.auth != null &&
        request.resource.data.customerId == request.auth.uid;
      
      // Customers can read their own orders
      allow read: if request.auth != null &&
        resource.data.customerId == request.auth.uid;
    }
    
    // Tasks collection - admin only
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Messages collection - admin only
    match /messages/{messageId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // QUOTES COLLECTION - exactly like your original detailed rules
    match /quotes/{quoteId} {
      // Basic admin access
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Additional validation for quote creation (from your original rules)
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      
      // Additional validation for quote updates (from your original rules)
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
      
      // Additional validation for quote deletion (from your original rules)
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Franchise Applications - exactly like your original rules
    match /franchiseApplications/{docId} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Contact Form Submissions - exactly like your original rules
    match /contactFormSubmissions/{docId} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Deals collection - admin only
    match /deals/{dealId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}

