rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY: Allow all access for development
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Users collection - simplified for basic auth system
    match /users/{userId} {
      // Users can read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admins can read all user data
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Allow list for admin user management (simplified from duplicate checking)
      allow list: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Simplified update protection: Prevent direct client updates to email/phone fields
      allow update: if request.auth != null && 
                   request.auth.uid == userId &&
                   // Prevent client-side updates to email and phone during profile updates
                   (
                     // If email field is being updated, it must remain the same
                     (!('email' in request.resource.data) || 
                      request.resource.data.email == resource.data.email) &&
                     // If phone field is being updated, it must remain the same  
                     (!('phone' in request.resource.data) || 
                      request.resource.data.phone == resource.data.phone)
                   );
    }
    
    // Leads collection - admin only
    match /leads/{leadId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Orders collection - customers can manage their own orders
    match /orders/{orderId} {
      // Admins can do everything
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Customers can create their own orders
      allow create: if request.auth != null &&
        request.resource.data.customerId == request.auth.uid;
      
      // Customers can read their own orders
      allow read: if request.auth != null &&
        resource.data.customerId == request.auth.uid;
      
      // Customers can update their own orders
      allow update: if request.auth != null &&
        resource.data.customerId == request.auth.uid;
      
      // Server-side operations for payment updates - NO AUTH REQUIRED
      // Allow updates when payment-related fields are being updated (indicates server-side payment processing)
      allow update: if 
        // Check if this is a payment-related update (server-side)
        ('paymentStatus' in request.resource.data) ||
        ('transactionId' in request.resource.data) ||
        ('paymentMode' in request.resource.data) ||
        ('paymentMessage' in request.resource.data) ||
        ('paymentTime' in request.resource.data) ||
        ('lastUpdated' in request.resource.data) ||
        ('status' in request.resource.data);
    }
    
    // Tasks collection - admin only
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Messages collection - admin only
    match /messages/{messageId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // QUOTES COLLECTION - admin only with validation
    match /quotes/{quoteId} {
      // Basic admin access
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Additional validation for quote creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      
      // Additional validation for quote updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
      
      // Additional validation for quote deletion
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Franchise Applications - public create, admin read/write
    match /franchiseApplications/{docId} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Contact Form Submissions - public create, admin read/write
    match /contactFormSubmissions/{docId} {
      allow create: if true;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Deals collection - admin only
    match /deals/{dealId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // ===== MESSAGING SYSTEM COLLECTIONS =====
    
    // Customers collection - admin only with validation
    match /customers/{customerId} {
      // Admin access with validation
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Temporary: Allow server-side access for development
      allow read, write: if request.auth == null;
      
      // Validation for customer creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      
      // Validation for customer updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
    }
    
    // Threads collection - admin only with validation
    match /threads/{threadId} {
      // Admin access with validation
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Temporary: Allow server-side access for development
      allow read, write: if request.auth == null;
      
      // Validation for thread creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      
      // Validation for thread updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
      
      // Messages subcollection - admin only
      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        
        // Temporary: Allow server-side access for development
        allow read, write: if request.auth == null;
        
        // Validation for message creation
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          request.resource.data.createdAt is timestamp;
        
        // Validation for message updates
        allow update: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          request.resource.data.updatedAt is timestamp;
      }
    }
    
    // Provider seen collection - admin only (for idempotency)
    match /providerSeen/{providerId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Template requests collection - admin only with validation
    match /templateRequests/{requestId} {
      // Admin access with validation
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Validation for template request creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.createdBy == request.auth.uid;
      
      // Validation for template request updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
    }
    
    // Campaigns collection - admin only with validation
    match /campaigns/{campaignId} {
      // Admin access with validation
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Validation for campaign creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.createdBy == request.auth.uid;
      
      // Validation for campaign updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
    }
    
    // Notifications collection - admin only with validation
    match /notifications/{notificationId} {
      // Admin access with validation
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Validation for notification creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdAt is timestamp;
      
      // Validation for notification updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
    }
    
    // SLA rules collection - admin only with validation
    match /slaRules/{ruleId} {
      // Admin access with validation
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Validation for SLA rule creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.createdBy == request.auth.uid;
      
      // Validation for SLA rule updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
    }
    
    // SLA violations collection - admin only with validation
    match /slaViolations/{violationId} {
      // Admin access with validation
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Validation for SLA violation creation
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.createdAt is timestamp;
      
      // Validation for SLA violation updates
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.data.updatedAt is timestamp;
    }
  }
}

